            "default": "mochi",
            "title": "Pet Id",
            "type": "string"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunView"
            },
            "title": "Runs",
            "type": "array"
          },
          "storage": {
            "default": "sqlite",
            "enum": [
              "sqlite",
              "dynamodb"
            ],
            "title": "Storage",
            "type": "string"
          }
        },
        "required": [
