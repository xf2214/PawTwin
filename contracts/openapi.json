{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": false,
        "properties": {
          "grams": {
            "default": 0,
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Grams",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "dispense_food",
              "create_play_task",
              "observe"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Action",
        "type": "object"
      },
      "AnalysisTelemetry": {
        "additionalProperties": false,
        "description": "Auditable model-call record (Day-2 acceptance: call records are checkable).\n\n``request_id`` stays ``None`` until a real Bedrock call happens, so a local\nrun can never be mistaken for a cloud one. Counts/durations/identifiers only.",
        "properties": {
          "backend": {
            "enum": [
              "inline",
              "local_fake",
              "bedrock"
            ],
            "title": "Backend",
            "type": "string"
          },
          "duration_ms": {
            "default": 0,
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "finished_at": {
            "format": "date-time",
            "title": "Finished At",
            "type": "string"
          },
          "limit_exceeded": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit Exceeded"
          },
          "model_calls": {
            "default": 0,
            "minimum": 0.0,
            "title": "Model Calls",
            "type": "integer"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "output_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "backend",
          "started_at",
          "finished_at"
        ],
        "title": "AnalysisTelemetry",
        "type": "object"
      },
      "ApprovalIn": {
        "additionalProperties": false,
        "properties": {
          "action_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Action Digest",
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "decline"
            ],
            "title": "Decision",
            "type": "string"
          },
          "proposal_version": {
            "exclusiveMinimum": 0.0,
            "title": "Proposal Version",
            "type": "integer"
          }
        },
        "required": [
          "decision",
          "proposal_version",
          "action_digest"
        ],
        "title": "ApprovalIn",
        "type": "object"
      },
      "DemoAck": {
        "additionalProperties": false,
        "description": "Echoes what changed so the UI never has to guess the new facts_version.",
        "properties": {
          "device_mode": {
            "anyOf": [
              {
                "enum": [
                  "succeeded",
                  "failed",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Mode"
          },
          "facts": {
            "$ref": "#/components/schemas/FactsView"
          }
        },
        "required": [
          "facts"
        ],
        "title": "DemoAck",
        "type": "object"
      },
      "DemoDeviceModeIn": {
        "additionalProperties": false,
        "description": "Injects the SIMULATED actuator outcome for NEW commands only.",
        "properties": {
          "mode": {
            "enum": [
              "succeeded",
              "failed",
              "unknown"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "DemoDeviceModeIn",
        "type": "object"
      },
      "DemoFactsIn": {
        "additionalProperties": false,
        "description": "Demo-only fact injection (Day-2 ruling 13).\n\n``extra='forbid'`` IS the hard-quota guard: the limits themselves\n(``daily_limit_grams`` / ``single_serving_grams`` / ``minimum_interval_minutes``)\ncan never be edited through this endpoint, so a demo request cannot raise the\ndaily budget. ``clear`` distinguishes \"leave unchanged\" from \"set to unknown\";\nnaming a field in both places is a conflict and is rejected.",
        "properties": {
          "clear": {
            "items": {
              "enum": [
                "last_fed_minutes_ago",
                "daily_dispensed_grams"
              ],
              "type": "string"
            },
            "title": "Clear",
            "type": "array"
          },
          "daily_dispensed_grams": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Dispensed Grams"
          },
          "last_fed_minutes_ago": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Fed Minutes Ago"
          },
          "reset": {
            "default": false,
            "title": "Reset",
            "type": "boolean"
          }
        },
        "title": "DemoFactsIn",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Shared error body, declared in OpenAPI ``responses`` (401/403/404/409).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventAccepted": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RunState"
          }
        },
        "required": [
          "run_id",
          "state"
        ],
        "title": "EventAccepted",
        "type": "object"
      },
      "EventIn": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "food_request",
              "attention_request"
            ],
            "title": "Kind",
            "type": "string"
          },
          "note": {
            "default": "",
            "maxLength": 500,
            "title": "Note",
            "type": "string"
          },
          "pet_id": {
            "const": "mochi",
            "default": "mochi",
            "title": "Pet Id",
            "type": "string"
          },
          "room": {
            "enum": [
              "kitchen",
              "living_room",
              "unknown"
            ],
            "title": "Room",
            "type": "string"
          },
          "source": {
            "const": "simulator",
            "default": "simulator",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "kind",
          "room"
        ],
        "title": "EventIn",
        "type": "object"
      },
      "EvidenceItem": {
        "additionalProperties": false,
        "description": "One read-only tool call that really happened.\n\nTool name, source, timestamp and a bounded summary only: never hidden\nreasoning, never the raw event note, never the full model request.",
        "properties": {
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "source": {
            "enum": [
              "repository",
              "policy",
              "memory"
            ],
            "title": "Source",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 300,
            "title": "Summary",
            "type": "string"
          },
          "tool": {
            "enum": [
              "get_pet_facts",
              "get_recent_events",
              "search_owner_memory",
              "get_policy_summary"
            ],
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "tool",
          "source",
          "retrieved_at"
        ],
        "title": "EvidenceItem",
        "type": "object"
      },
      "FactsView": {
        "additionalProperties": false,
        "properties": {
          "daily_dispensed_grams": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Dispensed Grams"
          },
          "daily_limit_grams": {
            "title": "Daily Limit Grams",
            "type": "integer"
          },
          "facts_version": {
            "title": "Facts Version",
            "type": "integer"
          },
          "last_fed_minutes_ago": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Fed Minutes Ago"
          },
          "minimum_interval_minutes": {
            "title": "Minimum Interval Minutes",
            "type": "integer"
          },
          "single_serving_grams": {
            "title": "Single Serving Grams",
            "type": "integer"
          }
        },
        "required": [
          "last_fed_minutes_ago",
          "daily_dispensed_grams",
          "daily_limit_grams",
          "single_serving_grams",
          "minimum_interval_minutes",
          "facts_version"
        ],
        "title": "FactsView",
        "type": "object"
      },
      "FeedbackIn": {
        "additionalProperties": false,
        "properties": {
          "scope": {
            "enum": [
              "observation",
              "today_only"
            ],
            "title": "Scope",
            "type": "string"
          },
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "scope"
        ],
        "title": "FeedbackIn",
        "type": "object"
      },
      "FeedbackView": {
        "additionalProperties": false,
        "description": "Owner feedback plus its HONEST long-term-memory lifecycle.\n\n``memory_status='saved'`` means the raw text is stored in the business\ndatabase; it never implies extraction. ``memory_backend`` is carried alongside\nso a judge can never read ``saved`` as \"AgentCore memory available\"\n(AGENTS.md L18). ``available`` only ever appears with real retrieval evidence.",
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "feedback_id": {
            "format": "uuid",
            "title": "Feedback Id",
            "type": "string"
          },
          "memory_backend": {
            "enum": [
              "not_implemented",
              "agentcore"
            ],
            "title": "Memory Backend",
            "type": "string"
          },
          "memory_status": {
            "enum": [
              "saved",
              "processing",
              "available",
              "failed"
            ],
            "title": "Memory Status",
            "type": "string"
          },
          "scope": {
            "enum": [
              "observation",
              "today_only"
            ],
            "title": "Scope",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "feedback_id",
          "scope",
          "text",
          "memory_status",
          "memory_backend",
          "created_at"
        ],
        "title": "FeedbackView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "passphrase": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Passphrase",
            "type": "string"
          }
        },
        "required": [
          "passphrase"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "additionalProperties": false,
        "properties": {
