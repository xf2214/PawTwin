      "StateView": {
        "additionalProperties": false,
        "properties": {
          "analyzer": {
            "enum": [
              "inline",
              "local_fake",
              "bedrock"
            ],
            "title": "Analyzer",
            "type": "string"
          },
          "aws_connected": {
            "title": "Aws Connected",
            "type": "boolean"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "device_mode": {
            "default": "succeeded",
            "enum": [
              "succeeded",
              "failed",
              "unknown"
            ],
            "title": "Device Mode",
            "type": "string"
          },
