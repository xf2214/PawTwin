            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "NewSessionView": {
        "additionalProperties": false,
        "description": "Result of ``POST /api/demo/new-session``: a fresh conversation id.\n\nPet memory, facts and the login session are preserved; only the conversation\n(the AgentCore session id) rotates, which is what makes cross-session\nretrieval demonstrable. The conversation id is never a pet identity.",
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          }
        },
        "required": [
          "conversation_id"
        ],
        "title": "NewSessionView",
        "type": "object"
      },
      "Proposal": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "explanation": {
            "maxLength": 1200,
            "title": "Explanation",
            "type": "string"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "title": "Missing Fields",
            "type": "array"
          }
        },
        "required": [
          "action",
          "explanation"
        ],
        "title": "Proposal",
        "type": "object"
      },
      "Receipt": {
        "additionalProperties": false,
        "properties": {
