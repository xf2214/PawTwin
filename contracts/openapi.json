  "info": {
    "title": "PawTwin",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bootstrap": {
      "get": {
        "operationId": "bootstrap_api_bootstrap_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Bootstrap Api Bootstrap Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Bootstrap"
      }
    },
    "/api/demo/device-mode": {
      "post": {
        "description": "Inject the SIMULATED actuator outcome for NEW commands only.\n\nProcess-local by design: it is not persisted, so a restart returns to the\ndocumented default instead of surprising the next demo with a stale failure.",
        "operationId": "post_demo_device_mode_api_demo_device_mode_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoDeviceModeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoAck"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid demo session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid X-CSRF-Token."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body failed validation."
          }
        },
        "summary": "Post Demo Device Mode"
      }
    },
    "/api/demo/facts": {
      "post": {
        "description": "Inject demo facts. Only the two injectable fields; never the hard limits.",
        "operationId": "post_demo_facts_api_demo_facts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoFactsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoAck"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid demo session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
