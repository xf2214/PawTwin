            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "simulated": {
            "const": true,
            "default": true,
            "title": "Simulated",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "status"
        ],
        "title": "Receipt",
        "type": "object"
      },
      "RunState": {
        "enum": [
          "queued",
          "analyzing",
          "needs_info",
          "blocked",
          "awaiting_approval",
          "declined",
          "expired",
          "executing",
          "succeeded",
          "failed",
          "unknown"
        ],
        "title": "RunState",
        "type": "string"
      },
      "RunView": {
        "additionalProperties": false,
        "properties": {
          "action_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Digest"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "title": "Evidence",
            "type": "array"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "facts_version": {
            "title": "Facts Version",
            "type": "integer"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "policy_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Reason"
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Proposal"
              },
              {
                "type": "null"
              }
            ]
          },
          "proposal_version": {
            "default": 0,
            "title": "Proposal Version",
            "type": "integer"
          },
          "receipt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Receipt"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RunState"
          },
          "telemetry": {
