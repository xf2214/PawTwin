# Local initialization does not contact AWS.
PAWTWIN_MODE=local

# Future AWS adapter configuration. AWS mode currently fails explicitly,
# even if these values are provided. Never paste AWS access keys here.
AWS_REGION=
BEDROCK_MODEL_ID=
DYNAMODB_TABLE_NAME=
AGENTCORE_MEMORY_ID=

# Optional absolute location of the compiled frontend for non-editable installs.
# PAWTWIN_FRONTEND_DIST=

# Optional process environment for Windows scripts (not loaded from .env):
# $env:PAWTWIN_NODE_DIR = 'C:\path\to\node'
# $env:PAWTWIN_NPM_CLI = 'C:\path\to\npm\bin\npm-cli.js'
