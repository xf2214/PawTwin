# Local initialization does not contact AWS.
PAWTWIN_MODE=local

# Local runtime. SQLite file path; defaults to in-memory when unset.
# A FILE path is what makes restart recovery verifiable; *.db is git-ignored.
# PAWTWIN_DB_PATH=

# Demo login gate. The default baked into config.py is a NON-SECRET local value.
# Set a private passphrase for judges here and deliver it via private test
# instructions; never commit a real secret or ship it to the frontend.
# PAWTWIN_DEMO_PASSPHRASE=

# --- Day-2: analyzer backend -------------------------------------------------
# inline      deterministic TEST backend: no retrieval, cites no evidence id.
# local_fake  labelled local stand-in (the default in local mode).
# bedrock     real model. Requires the optional `bedrock` extra AND credentials;
#             it NEVER falls back to a stand-in -- a missing dependency or
#             missing credential fails the run visibly (BACKEND_UNAVAILABLE).
# Setting bedrock does NOT make PAWTWIN_MODE=aws and does NOT set aws_connected:
# storage is still SQLite and long-term memory is still unimplemented.
# PAWTWIN_MODEL_BACKEND=local_fake

# --- Day-3: long-term memory backend -----------------------------------------
# not_implemented  honest local default: owner feedback is SAVED to the business
#                  database and search_owner_memory retrieves nothing (never a
#                  fabricated memory). No extraction runs, so a feedback item's
#                  status is 'saved' and is NEVER reported as 'available'.
# agentcore        real AWS Bedrock AgentCore Memory. Requires the optional `memory`
#                  extra, AGENTCORE_MEMORY_ID and credentials; it NEVER falls back
#                  to a stand-in -- a missing dependency or credential fails closed
#                  (MEMORY_UNAVAILABLE) and the honest label is kept.
# Setting agentcore does NOT make PAWTWIN_MODE=aws and does NOT set aws_connected:
# storage is still SQLite until the DynamoDB adapter exists.
# PAWTWIN_MEMORY_BACKEND=not_implemented

# --- Day-2: worker -----------------------------------------------------------
# inline      analyze inside the request (default; keeps tests deterministic).
# background  queue + leased worker thread (what the e2e server and container use).
# PAWTWIN_WORKER_MODE=inline

# --- Day-2: reliability budgets ----------------------------------------------
# Defaults follow the five-day spec. They are configurable so the ceilings can be
# tested quickly instead of waiting 45 real seconds.
# PAWTWIN_ANALYSIS_TIMEOUT_SECONDS=45
# PAWTWIN_MAX_MODEL_CALLS=4
# PAWTWIN_MAX_OUTPUT_TOKENS=800
# PAWTWIN_LEASE_SECONDS=60
# PAWTWIN_LEASE_RENEW_SECONDS=15
# PAWTWIN_MAX_ATTEMPTS=2
# Concurrency ceilings are enforced IN-PROCESS only for now; a cross-replica
# ceiling needs database-level counting and is deferred.
# PAWTWIN_MAX_CONCURRENT_PER_SESSION=1
# PAWTWIN_MAX_CONCURRENT_GLOBAL=2

# Future AWS adapter configuration. AWS mode currently fails explicitly, even if
# these values are provided. Never paste AWS access keys here. In local mode these
# matter only when PAWTWIN_MODEL_BACKEND=bedrock (BEDROCK_MODEL_ID) or
# PAWTWIN_MEMORY_BACKEND=agentcore (AGENTCORE_MEMORY_ID).
AWS_REGION=
BEDROCK_MODEL_ID=
DYNAMODB_TABLE_NAME=
AGENTCORE_MEMORY_ID=

# Optional absolute location of the compiled frontend for non-editable installs.
# PAWTWIN_FRONTEND_DIST=

# Optional process environment for Windows scripts (not loaded from .env):
# $env:PAWTWIN_NODE_DIR = 'C:\path\to\node'
# $env:PAWTWIN_NPM_CLI = 'C:\path\to\npm\bin\npm-cli.js'
# $env:PAWTWIN_BROWSER_EXECUTABLE = 'C:\path\to\chrome.exe'
